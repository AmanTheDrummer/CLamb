int sum(int left, int right) {
    return left + right;
}

int run() {
    int total = 0;
    int i = 0;
    auto add_total = lamb(int x) {
        return x + total;
    };
    for (i = 0; i < 3; i = i + 1) {
        total = sum(i, 1);
    }
    while (i > 0) {
        i = i - 1;
    }
    print(add_total(total));
    return sum(total, 1);
}
