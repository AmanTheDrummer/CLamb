int sum(int left, int right) {
    return left + right;
}

int run() {
    int values[3];
    int *data = malloc(8);
    int i = 0;
    auto add_total = lamb(int x) {
        return x + i;
    };
    for (i = 0; i < 3; i = i + 1) {
        values[i] = sum(i, 1);
    }
    values[i] = sum(i, 1)(i)[0];
    while (i > 0) {
        i = i - 1;
    }
    values[0] = *data;
    free(data);
    return values[0];
}